{
  "name": "accessly",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "pnpm --filter @accessly/web dev",
    "dev:worker": "tsx --env-file=.env.local apps/worker/src/index.ts",
    "dev:fixtures": "tsx tests/fixtures/server.ts",
    "local:setup": "tsx scripts/local-setup.ts",
    "local:stop": "supabase stop && docker compose -f infra/compose.yaml stop",
    "db:migrate": "tsx --env-file=.env.local packages/database/src/migrate.ts",
    "db:generate": "drizzle-kit generate --config packages/database/drizzle.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm --filter @accessly/extension build && pnpm --filter @accessly/web build",
    "extension:package": "tsx scripts/package-extension.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "format": "prettier --write 'apps/**/*.{ts,tsx,css,json,html}' 'packages/**/*.{ts,tsx,json}' 'tests/**/*.ts' 'scripts/**/*.ts' '*.ts' '*.mjs' '*.json' 'infra/*.yaml' 'pnpm-workspace.yaml' --ignore-path .gitignore",
    "format:check": "prettier --check 'apps/**/*.{ts,tsx,css,json,html}' 'packages/**/*.{ts,tsx,json}' 'tests/**/*.ts' 'scripts/**/*.ts' '*.ts' '*.mjs' '*.json' 'infra/*.yaml' 'pnpm-workspace.yaml' --ignore-path .gitignore",
    "local:ports": "tsx scripts/local-ports.ts",
    "local:backup": "tsx scripts/local-backup.ts create",
    "local:backup:verify": "tsx scripts/local-backup.ts verify",
    "test:e2e:production": "pnpm --filter @accessly/web build && ACCESSLY_SERVER_MODE=production playwright test",
    "local:restore": "tsx scripts/local-restore.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "axe-core": "4.14.0",
    "bullmq": "6.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "playwright": "1.64.1",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/archiver": "8.0.0",
    "@types/chrome": "0.3.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "archiver": "8.0.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "prettier": "3.8.3",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "type": "module"
}
